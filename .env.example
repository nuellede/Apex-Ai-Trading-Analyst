# ===================================================
# APEX AI TRADING ANALYST - ENVIRONMENT CONFIGURATION
# ===================================================

# GEMINI_API_KEY (REQUIRED on Server / Vercel Environment Variables)
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
# NEVER expose this key to client-side bundles (do not prefix with VITE_).
GEMINI_API_KEY="your_gemini_api_key_here"

# GEMINI_MODEL (OPTIONAL - Default: gemini-3.8-flash)
# Supported vision models: gemini-3.8-flash, gemini-flash-latest
GEMINI_MODEL="gemini-3.8-flash"

# PORT (OPTIONAL - Default: 3000 for local development)
PORT=3000

# NODE_ENV (development | production)
NODE_ENV="development"
